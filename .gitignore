# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# SFU section lists are a local fetch cache; data/raw/outlines/_manifest.json (section types
# per term) and data/generated/offerings.json replace them in git
data/raw/outlines/**/*.sections.json

# reference PDFs (may contain a real student's progress); keep only the README
data/sources/*
!data/sources/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
