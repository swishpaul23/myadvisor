ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DATABASE_URL=
CONTACT_EMAIL=

# Auth.js (Google sign-in). Generate AUTH_SECRET with `npx auth secret`; the Google values
# come from Google Cloud Console (README "Auth setup").
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini (transcript parsing and the advisor), from Google AI Studio. Server-only: never
# prefix with NEXT_PUBLIC_. Without it, upload shows "Upload unavailable".
GOOGLE_GENERATIVE_AI_API_KEY=

# Reference data: json (default, data/generated/) or snowflake (falls back to json on
# error or after SNOWFLAKE_TIMEOUT_MS).
DATA_SOURCE=json
SNOWFLAKE_TIMEOUT_MS=15000

# Snowflake key-pair auth (service user). rsa_key.p8 is gitignored; never commit it.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=app_user
SNOWFLAKE_ROLE=app_role
SNOWFLAKE_WAREHOUSE=demo_wh
SNOWFLAKE_DATABASE=myadvisor
SNOWFLAKE_SCHEMA=app
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
